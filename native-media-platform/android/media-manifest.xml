<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <application>
    <provider android:name="top.maplayer.collaboration.media.MediaInitProvider" android:authorities="${applicationId}.media-init" android:exported="false" />
    <activity android:name="top.maplayer.collaboration.media.NativeCallActivity" android:exported="false" android:configChanges="orientation|screenSize" />
    <service android:name="top.maplayer.collaboration.media.NativeCaptureService" android:foregroundServiceType="camera|microphone|mediaProjection" android:exported="false" />
  </application>
</manifest>

# Bun server
PORT=8080
NODE_ENV=development

# SurrealDB
# 必须来自 native quota candidate/production receipt，且必须固定 digest；禁止 tag 和官方镜像。
# 示例格式（不要把示例当真实 digest）：
# SURREALDB_NATIVE_QUOTA_IMAGE=ghcr.io/mainlistactivity/surrealdb-native-quota@sha256:<64-hex>
SURREALDB_NATIVE_QUOTA_IMAGE=
SURREAL_URL=ws://surrealdb:8000/rpc
SURREAL_NS=main
SURREAL_ROOT_USER=root
SURREAL_ROOT_PASS=change_me
CONTENT_DATABASE=platform_content
# 至少 32 位随机值。只在 server 使用；root 启动时维护内容库内的 publisher 凭证。
CONTENT_PUBLISHER_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# dev 默认打印 SurrealDB query；生产默认关闭。显式设 false/0 可关闭，true/1 可开启。
SURREAL_LOG_QUERIES=true

# OIDC
OIDC_ISSUER=https://o.maplayer.top/t/ck
OIDC_JWKS_URL=https://o.maplayer.top/t/ck/jwks.json
OIDC_AUDIENCE=https://auth.maplayer.top
# 运营端 / 内容 MCP 独立 audience；生产必须与 IdP 资源服务器配置一致。
OIDC_OPS_AUDIENCE=https://l.maplayer.top/api/ops/mcp
# OIDC_OPS_CLIENT_ID=your-operations-public-client-id
# 后端 confidential client 用于代理 authorization_code token exchange；不要放入 VITE_*。
OIDC_CLIENT_ID=change_me
OIDC_CLIENT_SECRET=change_me
OIDC_TOKEN_ENDPOINT=https://o.maplayer.top/t/ck/token
# 运营 MCP 每个请求会使用本 confidential client 校验 access token 未被撤销。
OIDC_INTROSPECTION_ENDPOINT=https://o.maplayer.top/t/ck/introspect
# 必须与 IdP 中该 web client 的 token_endpoint_auth_method 一致。
OIDC_TOKEN_AUTH_METHOD=client_secret_basic

# IdP token scope adapter / hook
IDP_SCOPE_API_URL=https://o.maplayer.top/t/ck/scope
# 与 IdP（ma_hono）的 CLAIM_HOOK_SECRET 对齐；登录 hook（default-scope）的 Bearer 鉴权
IDP_HOOK_SECRET=change_me_hook_secret

# 部署级 workspace 创建开关的 seed：任意非空 subject 会使 system_admin 表非空，从而对所有
# 已登录真人开放创建；这不是逐 subject allowlist。留空且表为空时，所有人都不可创建。
# 登录 hook 同时返回 can_create_workspace；无 workspace 时 scope 落 _system 以承接创建流程。
SYSTEM_ADMIN_SUBJECTS=

# 可选的平台运营 bootstrap。两项必须同时配置；能力名逗号分隔。
# 只补缺失的 operator/capability，不会在重启时重新启用已禁用主体或已撤销能力。
# LCA14 灰度开关/批次写操作另需 rollout.manage（读沿用 quota.read）。
# 例如：PLATFORM_OPERATOR_SUBJECTS=<oidc-user-id>
#       PLATFORM_OPERATOR_CAPABILITIES=content.read,content.submit,content.publish,content.withdraw,content.restore,content.source.manage,rollout.manage
PLATFORM_OPERATOR_SUBJECTS=
PLATFORM_OPERATOR_CAPABILITIES=
PLATFORM_OPERATOR_DISPLAY_NAME=
PLATFORM_OPERATOR_GRANTOR_SUBJECT=system:env-bootstrap

# 新 workspace 要安装的可选模板包，逗号分隔并按配置顺序执行；留空时不播种垂直模板。
# 当前可选：legal-starter（案件 / 实体 / 合规 / 尽调 / 资产）、bankruptcy-claims（破产债权管理）。
WORKSPACE_TEMPLATE_PACKS=

# _system index 校对心跳间隔（秒）；启动跑一次后按此周期重复
RECONCILE_INTERVAL_SEC=3600

# 虚拟员工会话 token 续约点（秒，缺省 2700=45min，须低于 employee access 的 session DURATION 1h）
EMPLOYEE_SESSION_RENEW_AFTER_SEC=2700
# 员工 runtime 关停排空截止时间（毫秒，缺省 30s）；到点未排空的窗口收到 abort
EMPLOYEE_RUNTIME_SHUTDOWN_DEADLINE_MS=30000
# abort 下发后等待窗口收尾的宽限（毫秒，缺省 5s）
EMPLOYEE_SHUTDOWN_ABORT_GRACE_MS=5000
# 启动时分批 reconcile 的并发上限（缺省 4）
EMPLOYEE_STARTUP_RECONCILE_CONCURRENCY=4

# Mastra 可观测性 span/event 保留天数（缺省 30）；过期由 SurrealDB expires_at 兜底清理
MASTRA_OBSERVABILITY_RETENTION_DAYS=30

# AI 模型 provider / model / key（生产装配 AiChatService 用；三者及交付加密 key 齐备才接线，否则 /api/chat 返回 501）。
# 示例：AI_PROVIDER=openai AI_MODEL=sensenova-6.8-flash-lite AI_API_KEY=sk-...
# SenseNova OpenAI 兼容网关：chat 用 sensenova-6.8-flash-lite。sensenova-6.7-flash-lite 仍会出现在 /v1/models，但 /v1/chat/completions 已返回 404 model route not found。
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# 交付加密：32 字节随机 key 的 64 位 hex；仅服务端，跨重启保留。更换会使旧结果不可补取。
# 发布前由运维准备 production ORIGIN_ENV_AI_DELIVERY_KEY；禁止放入 VITE_*。
AI_DELIVERY_KEY=
# 可选自定义 endpoint（OpenAI 兼容代理 / 本地推理）
AI_BASE_URL=

# 资源保存确认动作（POST /api/resources/research/save）的 embedding key，与 chat 模型分离。
# 未配置时：无 embedding profile 的 workspace 照常保存（disabled），有 profile 的保存会失败。
EMBEDDING_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# 债权人令牌入口（claims-portal）。均为可选；缺 pepper → mint/open 501 claims-portal-not-configured。
# 生产在 Cloudflare production Environment 登记 ORIGIN_ENV_CLAIMS_PORTAL_TOKEN_PEPPER
# 与 ORIGIN_ENV_CLAIMS_ATTACHMENT_*（五个附件键必须齐备，缺任一 → 上传/下载 501
# attachment-storage-not-configured）。禁止放入 VITE_*。
# ─────────────────────────────────────────────────────────────────────────
CLAIMS_PORTAL_TOKEN_PEPPER=
CLAIMS_ATTACHMENT_ACCOUNT_ID=
CLAIMS_ATTACHMENT_ACCESS_KEY_ID=
CLAIMS_ATTACHMENT_SECRET_ACCESS_KEY=
CLAIMS_ATTACHMENT_BUCKET=
CLAIMS_ATTACHMENT_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────
# 前端构建（Vite 从仓库根读 .env，见 web/vite.config.ts envDir: ".."）。
# 这些 VITE_* 会被打进前端 bundle，只能放公开值；不要放任何 secret。
# 缺 VITE_SURREAL_URL 时浏览器直连 SurrealDB 会在 connectSurreal 抛错。
# ─────────────────────────────────────────────────────────────────────────
# 浏览器直连 SurrealDB 的 WSS 地址（公网 TLS）；dev 可用 ws://localhost:8000/rpc
VITE_SURREAL_URL=ws://localhost:8000/rpc
# dev 默认打印浏览器直连 query；生产默认关闭。显式设 false/0 可关闭，true/1 可开启。
VITE_SURREAL_LOG_QUERIES=true
# Bun server 对外地址；dev 走 vite 代理时填相对路径 /api 即可
VITE_API_BASE_URL=/api
# OIDC SPA 登录壳（oidc-client-ts）；issuer / audience 与后端 OIDC_* 对齐
VITE_OIDC_ISSUER=https://o.maplayer.top/t/ck
VITE_OIDC_AUDIENCE=https://auth.maplayer.top
# 前端 public client（PKCE，无 secret），与后端 confidential client 不是同一个
VITE_OIDC_CLIENT_ID=change_me
# 登录回调地址；dev 默认 vite 端口
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

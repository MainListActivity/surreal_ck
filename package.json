{
  "name": "surreal-ck",
  "version": "0.1.0",
  "description": "Graph-powered collaborative spreadsheet — table = database table",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @surreal-ck/server dev",
    "dev:server": "pnpm --filter @surreal-ck/server dev",
    "test": "pnpm -r --if-present run test",
    "test:quota:local": "pnpm --filter @surreal-ck/shared run test:quota:local",
    "test:quota:cross-repo": "pnpm --filter @surreal-ck/server run test:quota:cross-repo",
    "test:quota:integration": "pnpm --filter @surreal-ck/shared run test:quota:integration && pnpm --filter @surreal-ck/server run test:quota:integration",
    "quota:migration": "pnpm --filter @surreal-ck/server run quota:migration --",
    "lint": "oxlint --deny-warnings server shared web scripts",
    "typecheck": "pnpm -r run typecheck",
    "icon:generate": "node scripts/generate-app-icons.mjs"
  },
  "devDependencies": {
    "oxlint": "1.48.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "server",
    "web",
    "shared"
  ]
}

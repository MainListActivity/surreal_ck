-- 内部首次价值测试控制面；不承载客户正文或产品AI单位账本。
DEFINE TABLE IF NOT EXISTS internal_ai_activity SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS goal ON internal_ai_activity TYPE string;
DEFINE FIELD IF NOT EXISTS enabled ON internal_ai_activity TYPE bool DEFAULT false;
DEFINE FIELD IF NOT EXISTS total_limit ON internal_ai_activity TYPE int ASSERT $value > 0 AND $value <= 1000000000;
DEFINE FIELD IF NOT EXISTS per_attempt_limit ON internal_ai_activity TYPE int ASSERT $value > 0 AND $value <= 100000000;
DEFINE FIELD IF NOT EXISTS attempt_limit ON internal_ai_activity TYPE int ASSERT $value > 0 AND $value <= 30;
DEFINE FIELD IF NOT EXISTS reserved ON internal_ai_activity TYPE int DEFAULT 0 ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS spent ON internal_ai_activity TYPE int DEFAULT 0 ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS attempts ON internal_ai_activity TYPE int DEFAULT 0 ASSERT $value >= 0 AND $value <= 30;
DEFINE FIELD IF NOT EXISTS approval_revision ON internal_ai_activity TYPE option<string>;
DEFINE FIELD IF NOT EXISTS evidence_expires_at ON internal_ai_activity TYPE option<string>;
DEFINE FIELD IF NOT EXISTS price_revisions ON internal_ai_activity TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS balance_nano_usd ON internal_ai_activity TYPE option<int>;
DEFINE FIELD IF NOT EXISTS balance_currency ON internal_ai_activity TYPE option<string>;
DEFINE FIELD IF NOT EXISTS balance_source ON internal_ai_activity TYPE option<string>;
DEFINE FIELD IF NOT EXISTS balance_sampled_at ON internal_ai_activity TYPE option<string>;
DEFINE FIELD IF NOT EXISTS balance_evidence_hash ON internal_ai_activity TYPE option<string>;
DEFINE FIELD IF NOT EXISTS auto_topup_disabled ON internal_ai_activity TYPE bool DEFAULT false;
DEFINE FIELD IF NOT EXISTS service_approved ON internal_ai_activity TYPE bool DEFAULT false;
DEFINE TABLE IF NOT EXISTS internal_ai_binding SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS identity_hash ON internal_ai_binding TYPE string;
DEFINE FIELD IF NOT EXISTS activity ON internal_ai_binding TYPE string;
-- 撤销是持久状态不是删除：撤销后同一身份新旧run/key一律拒绝，不降级客户路径。
DEFINE FIELD IF NOT EXISTS revoked ON internal_ai_binding TYPE bool DEFAULT false;
DEFINE INDEX IF NOT EXISTS internal_ai_identity ON internal_ai_binding COLUMNS identity_hash UNIQUE;
DEFINE TABLE IF NOT EXISTS internal_ai_run SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS activity ON internal_ai_run TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS identity_hash ON internal_ai_run TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS run_hash ON internal_ai_run TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS key_hash ON internal_ai_run TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS logical_hash ON internal_ai_run TYPE string READONLY;
-- 身份历史核验：binding 被删除后仍能证明该身份曾参与内部活动。
DEFINE INDEX IF NOT EXISTS internal_ai_run_identity ON internal_ai_run COLUMNS identity_hash;
DEFINE TABLE IF NOT EXISTS internal_ai_attempt SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS activity ON internal_ai_attempt TYPE record<internal_ai_activity>;
DEFINE FIELD IF NOT EXISTS retry_index ON internal_ai_attempt TYPE int ASSERT $value = 0;
DEFINE FIELD IF NOT EXISTS sequence ON internal_ai_attempt TYPE int;
DEFINE FIELD IF NOT EXISTS run_hash ON internal_ai_attempt TYPE string;
DEFINE FIELD IF NOT EXISTS key_hash ON internal_ai_attempt TYPE string;
DEFINE FIELD IF NOT EXISTS logical_hash ON internal_ai_attempt TYPE string;
DEFINE FIELD IF NOT EXISTS stage ON internal_ai_attempt TYPE string;
DEFINE FIELD IF NOT EXISTS provider ON internal_ai_attempt TYPE string;
DEFINE FIELD IF NOT EXISTS model ON internal_ai_attempt TYPE string;
DEFINE FIELD IF NOT EXISTS actual_model ON internal_ai_attempt TYPE option<string>;
DEFINE FIELD IF NOT EXISTS request_id ON internal_ai_attempt TYPE option<string>;
DEFINE FIELD IF NOT EXISTS reserved ON internal_ai_attempt TYPE int;
DEFINE FIELD IF NOT EXISTS cost ON internal_ai_attempt TYPE option<int>;
DEFINE FIELD IF NOT EXISTS state ON internal_ai_attempt TYPE string ASSERT $value INSIDE ["reserved", "sent", "settled", "uncertain"];
DEFINE FIELD IF NOT EXISTS usage ON internal_ai_attempt TYPE option<object> FLEXIBLE;
DEFINE FIELD IF NOT EXISTS usage_source ON internal_ai_attempt TYPE string;
DEFINE FIELD IF NOT EXISTS price_revision ON internal_ai_attempt TYPE string;
DEFINE FIELD IF NOT EXISTS currency ON internal_ai_attempt TYPE string;
DEFINE FIELD IF NOT EXISTS started_at ON internal_ai_attempt TYPE datetime;
DEFINE FIELD IF NOT EXISTS ended_at ON internal_ai_attempt TYPE option<datetime>;
DEFINE INDEX IF NOT EXISTS internal_ai_sequence ON internal_ai_attempt COLUMNS activity, sequence UNIQUE;
DEFINE TABLE IF NOT EXISTS internal_ai_target SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS reserved ON internal_ai_target TYPE int DEFAULT 0 ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS spent ON internal_ai_target TYPE int DEFAULT 0 ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS attempts ON internal_ai_target TYPE int DEFAULT 0 ASSERT $value >= 0 AND $value <= 30;

          viewType: "bar",
          spec: {
            sourceTables: ["claims"],
            baseTable: "claims",
            metric: { op: "count" },
            dimensions: [{ field: "claim_nature" }],
            limit: 10,
          },
          grid: {
            x: 0,
            y: 1,
            w: 6,
            h: 2,
          },
        },
        {
          id: "review-status-distribution",
          title: "审查状态分布",
          viewType: "pie",
          spec: {
            sourceTables: ["claims"],
            baseTable: "claims",
            metric: { op: "count" },
            dimensions: [{ field: "review_status" }],
            limit: 10,
          },
          grid: {
            x: 6,
            y: 1,
            w: 6,
            h: 2,
          },
        },
        {
          id: "recent-claims",
          title: "最近申报",
          viewType: "table",
          spec: {
            sourceTables: ["claims"],
            baseTable: "claims",
            metric: { op: "count" },
            sort: {
              field: "declared_date",
              direction: "desc",
            },
            limit: 8,
          },
          grid: {
            x: 0,
            y: 3,
            w: 12,
            h: 2,
          },
          display: {
            columns: [
              { key: "creditor", label: "债权人" },
              { key: "declared_amount", label: "申报金额" },
              { key: "claim_nature", label: "债权性质" },
              { key: "review_status", label: "审查状态" },
              { key: "declared_date", label: "申报日期" },
            ],
          },
        },
      ],
    },
  },
]
ON DUPLICATE KEY UPDATE
  label = $input.label,
  icon = $input.icon,
  accent = $input.accent,
  default_name = $input.default_name,
  description = $input.description,
  builtin = $input.builtin,
  sort_order = $input.sort_order,
  sheet_defs = $input.sheet_defs,
  quick_tasks = $input.quick_tasks,
  row_analysis = $input.row_analysis,
  default_dashboard = $input.default_dashboard;

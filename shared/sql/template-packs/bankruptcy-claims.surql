    row_analysis: {
      background: "当前工作簿用于破产程序中的债权申报登记与审查管理。分析应围绕申报金额、利息、债权性质、审查结论和证据材料说明展开，不替代管理人或律师的专业判断。",
      field_semantics: [
        { field_key: "creditor_name", meaning: "提出债权申报的主体名称" },
        { field_key: "identity_type", meaning: "申报主体的证件类型，用于区分企业与自然人" },
        { field_key: "identity_number", meaning: "识别申报主体及疑似重复申报的稳定身份信息" },
        { field_key: "declared_amount", meaning: "债权人本次申报的债权金额" },
        { field_key: "interest_amount", meaning: "申报口径下的利息金额，与申报金额分列" },
        { field_key: "claim_nature", meaning: "债权性质分类，影响清偿顺序" },
        { field_key: "declared_date", meaning: "债权申报的受理日期" },
        { field_key: "evidence_note", meaning: "支撑该笔申报的证据材料及其完整性的说明" },
        { field_key: "review_status", meaning: "当前债权审查所处状态及结论" },
        { field_key: "reviewed_amount", meaning: "经审查确认或拟确认的审定金额" },
        { field_key: "review_opinion", meaning: "审查结论的依据说明" },
      ],
      review_points: [
        "摘要必须覆盖申报金额、审查状态、证据材料说明和可用的引用依据。",
        "审定金额必须有审查依据支撑；依据不足时按缺失信息列出，不得直接给出审定数字。",
        "金额异常包括审定金额与申报金额差异显著、审定金额超过申报金额或金额与证据材料说明不一致。",
        "债权性质影响清偿顺序；性质判断应结合证据材料说明，分类依据不足时明确说明待确认。",
        "疑似重复申报应结合证件号码、债权人名称、申报金额及关联记录判断，不得只凭名称下结论。",
        "缺失项检查清单：证据材料说明为空、利息无计算说明、审查状态长期停留在待审查或审查中的记录应逐项列出。",
        "待办建议应关联具体申报记录，说明需要补充或复核的内容；信息不足时保留为空或说明待确认。",
      ],
      output_guidance: [
        "有记录关联资源时使用 [1]、[2] 格式引用，并确保编号对应工具返回的 citation。",
        "没有关联资源时明确分开列示台账事实与模型建议，不得把模型推断写成已有材料结论。",
        "任何字段补全都只能形成写入提案，等待用户确认后执行。",
      ],
    },

---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "卯豆｜AI 原生的数据工作空间",
  description = "从一张表开始，让数据、协作与 AI 在同一个工作空间里自然生长。",
} = Astro.props;

// 分享图必须是绝对 URL。营销站域名固定，直接写生产域名——曾计划用 worker 在
// 响应时替换占位域名，但 Pages 部署只上传 dist/client，替换逻辑从未生效，
// 线上 og:image 实际是无效的 site.invalid。
const siteOrigin = "https://www.maplayer.top";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#efebe2" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteOrigin}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${siteOrigin}/og.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,500;0,600;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Noto+Serif+SC:wght@500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // 移动端导航是 details/summary：点菜单内链接跳到锚点后菜单仍展开，会挡住
  // 目标区块。这里在捕获阶段收起，交给浏览器继续处理跳转。
  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;
    const details = target.closest<HTMLDetailsElement>("details.mobile-nav");
    if (!details || !details.open) return;
    if (target.closest("nav a")) details.open = false;
  });
</script>

  .footer-login { display: inline-flex; justify-self: end; align-items: center; gap: 7px; padding-bottom: 5px; border-bottom: 1px solid rgba(255,255,255,.22); color: #dfe8e1; font-size: 10px; font-weight: 700; }
  .footer-bottom { display: flex; justify-content: space-between; margin-top: 58px; padding-top: 19px; border-top: 1px solid rgba(255,255,255,.08); color: #64766a; font-size: 8px; }

  @media (max-width: 920px) {
    .desktop-nav { display: none; }
    .nav-inner { grid-template-columns: 1fr auto; }
    .nav-actions { display: none; }
    .mobile-nav { position: relative; display: block; justify-self: end; }
    .mobile-nav summary { display: grid; width: 39px; height: 39px; place-items: center; border: 1px solid rgba(255,255,255,.14); border-radius: 10px; background: rgba(255,255,255,.08); color: white; cursor: pointer; list-style: none; }
    .mobile-nav summary::-webkit-details-marker { display: none; }

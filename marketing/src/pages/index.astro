---
import {
  ArrowRight,
  ChartColumn,
  Bot,
  Check,
  ChevronRight,
  CircleCheck,
  Database,
  FileSearch,
  GalleryVerticalEnd,
  Import,
  LayoutDashboard,
  Link2,
  Menu,
  Rows3,
  ShieldCheck,
  Sparkles,
  Table2,
  Users,
  WandSparkles,
  X,
} from "@lucide/astro";
import Brand from "../components/Brand.astro";
import ProductStage from "../components/ProductStage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { capabilityCards, navigation, templateCards, workflowSteps } from "../data/product";

const appUrl = import.meta.env.PUBLIC_APP_URL || "/auth/login";
const iconByName = {
  database: Database,
  layout: GalleryVerticalEnd,
  sparkles: Sparkles,
} as const;
---

<BaseLayout>
  <div class="page-shell">
    <header class="site-header">
      <div class="container nav-inner">
        <a class="brand-link" href="#top" aria-label="卯豆首页"><Brand /></a>
        <nav class="desktop-nav" aria-label="主导航">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="nav-actions">
          <a class="login-link" href={appUrl}>登录</a>
          <a class="nav-cta" href={appUrl}>开始使用 <ArrowRight size={14} /></a>
        </div>
        <details class="mobile-nav">
          <summary aria-label="打开导航"><Menu class="menu-open" size={21} /><X class="menu-close" size={21} /></summary>
          <nav aria-label="移动端导航">
            {navigation.map((item) => <a href={item.href}>{item.label}<ChevronRight size={14} /></a>)}
            <a class="mobile-login" href={appUrl}>进入工作空间 <ArrowRight size={14} /></a>
          </nav>
        </details>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-grain" aria-hidden="true"></div>
        <div class="hero-orbit orbit-one" aria-hidden="true"></div>
        <div class="hero-orbit orbit-two" aria-hidden="true"></div>
        <div class="container hero-content">
          <p class="hero-badge"><Sparkles size={13} /> AI 原生的数据工作空间 <span>NEW</span></p>
          <h1>让每一张表，<br /><em>成为行动的起点。</em></h1>
          <p class="hero-lead">
            卯豆把表格、数据库、团队协作与 AI 放进同一个工作空间。<br class="wide-only" />
            从整理信息到形成判断，让数据自然长成团队的工作方式。
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={appUrl}>开始使用卯豆 <ArrowRight size={15} /></a>
            <a class="button button-secondary" href="#capabilities">看看能做什么</a>
          </div>
          <div class="hero-notes" aria-label="产品特点">
            <span><Check size={13} /> Excel / CSV 快速导入</span>
            <span><Check size={13} /> 实时多人协作</span>
            <span><Check size={13} /> AI 理解工作上下文</span>
          </div>
          <ProductStage />
        </div>
      </section>

      <section class="premise section-space">
        <div class="container premise-grid">
          <div>
            <p class="eyebrow">一个事实源，多种工作方式</p>
            <h2>不是给表格增加功能，<br />而是让工作重新围绕数据组织。</h2>
          </div>
          <div class="premise-copy">
            <p>团队真正需要的不是更多散落的工具，而是一份随时准确、人人都能理解、可以继续行动的数据。</p>
            <p>卯豆保留表格的直觉，把结构、关联、权限和智能藏在背后，让复杂工作仍然简单。</p>
          </div>
        </div>
      </section>

      <section id="capabilities" class="capabilities section-space">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">产品能力</p>
            <h2>熟悉的开始，更深的可能</h2>
            <p>每一项能力都围绕同一个目标：让团队更快地从信息走向结论。</p>
          </div>
          <div class="capability-grid">
            {capabilityCards.map((item, index) => {
              const Icon = iconByName[item.icon];
              return (
                <article class:list={["capability-card", `card-${index + 1}`]}>
                  <div class="capability-icon"><Icon size={20} stroke-width={1.8} /></div>
                  <p>{item.eyebrow}</p>
                  <h3>{item.title}</h3>
                  <span>{item.description}</span>
                  <div class="card-index">0{index + 1}</div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section class="showcase section-space">
        <div class="container">
          <div class="section-heading compact">
            <p class="eyebrow">从不同角度看见工作</p>
            <h2>一份数据，服务每一种角色</h2>
          </div>

          <div class="bento-grid">
            <article class="bento views-card">
              <div class="bento-copy">
                <span class="feature-label"><Rows3 size={15} /> 多视图协作</span>
                <h3>负责人看进度，管理者看全局，<br />数据仍然只有一份。</h3>
                <p>在表格、看板、画廊与表单之间自由切换，每个人都用适合自己的方式完成工作。</p>
              </div>
              <div class="kanban-demo" aria-label="看板视图示意">
                <div class="kanban-top"><strong>债权审查进度</strong><span><Table2 size={11} /> 表格</span><span class="active"><Rows3 size={11} /> 看板</span></div>
                <div class="kanban-columns">
                  <div><p><i class="dot sand"></i>待核验 <em>8</em></p><span><b>华远供应链</b><small>¥ 680,000 · 林澈</small></span><span><b>合信商贸</b><small>缺少付款凭证</small></span></div>
                  <div><p><i class="dot orange"></i>复核中 <em>5</em></p><span><b>北辰实业</b><small>存在金额异议</small></span><span><b>启航物流</b><small>今日更新</small></span></div>
                  <div><p><i class="dot green"></i>已确认 <em>24</em></p><span><b>知行科技</b><small>材料完整</small></span><span class="ghost-card"><b>+ 新建记录</b></span></div>
                </div>
              </div>
            </article>

            <article class="bento ai-showcase">
              <div class="ai-orb"><WandSparkles size={22} /></div>
              <span class="feature-label light"><Sparkles size={15} /> 卯豆 AI</span>
              <h3>把问题说出来，<br />让答案回到工作里。</h3>
              <p>AI 会理解当前工作簿、筛选条件与记录关联，不只回答问题，还能生成视图、图表与下一步动作。</p>
              <div class="prompt-card">
                <p>“按负责人汇总有异议的债权，并生成本周复核计划。”</p>
                <div><span><Bot size={14} /> 正在分析 126 条记录</span><i></i><i></i><i></i></div>
              </div>
            </article>

            <article class="bento dashboard-card">
              <div class="bento-copy small-copy">
                <span class="feature-label"><ChartColumn size={15} /> 实时仪表盘</span>
                <h3>数字变化，结论同步更新</h3>
                <p>无需维护另一份报表，图表始终基于最新数据。</p>
              </div>
              <div class="chart-demo" aria-label="仪表盘图表示意">
                <header><span><small>申报总额</small><strong>¥12.84M</strong></span><em>较上周 +8.2%</em></header>
                <div class="chart-body">
                  <div class="y-axis"><span>12M</span><span>8M</span><span>4M</span><span>0</span></div>
                  <div class="bars"><i style="--bar:35%"></i><i style="--bar:52%"></i><i style="--bar:43%"></i><i style="--bar:68%"></i><i style="--bar:61%"></i><i class="active" style="--bar:84%"></i><i style="--bar:74%"></i></div>
                </div>
                <div class="chart-labels"><span>周一</span><span>周二</span><span>周三</span><span>周四</span><span>周五</span><span>周六</span><span>今日</span></div>
              </div>
            </article>

            <article class="bento research-card">
              <div class="bento-copy small-copy">
                <span class="feature-label"><FileSearch size={15} /> 资料与记录关联</span>
                <h3>结论有出处，材料有归属</h3>
                <p>把研究资料、证据与业务记录连接起来，随时追溯判断依据。</p>
              </div>
              <div class="link-demo">
                <div class="doc-card"><span>PDF</span><p><strong>债权申报书.pdf</strong><small>12 页 · 已提取</small></p><CircleCheck size={15} /></div>
                <div class="connector"><i></i><Link2 size={14} /><i></i></div>
                <div class="record-card"><span>记录</span><p><small>债权人</small><strong>华远供应链</strong></p><p><small>申报金额</small><strong>¥ 680,000</strong></p></div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="templates" class="templates section-space">
        <div class="container template-layout">
          <div class="template-intro">
            <p class="eyebrow">行业模板</p>
            <h2>从行业经验开始，<br />不必从空白表格开始。</h2>
            <p>字段、视图和工作流程已经按实际场景组织好。选择模板，导入资料，然后按照团队习惯继续调整。</p>
            <a href={appUrl}>浏览全部模板 <ArrowRight size={14} /></a>
          </div>
          <div class="template-list">
            {templateCards.map((template) => (
              <a class:list={["template-item", template.tone]} href={appUrl}>
                <span class="template-number">{template.number}</span>
                <span class="template-icon"><LayoutDashboard size={18} /></span>
                <span class="template-name"><strong>{template.name}</strong><small>{template.meta}</small></span>
                <ChevronRight size={18} />
              </a>
            ))}
          </div>
        </div>
      </section>

      <section id="workflow" class="workflow section-space">
        <div class="container">
          <div class="workflow-head">
            <div><p class="eyebrow">工作方式</p><h2>三步，把信息变成团队能力</h2></div>
            <p>卯豆不要求团队改变熟悉的工作习惯，只把每一步连接得更自然。</p>
          </div>
          <div class="workflow-steps">
            {workflowSteps.map((step, index) => (
              <article>
                <div class="step-top"><span>{step.number}</span>{index === 0 ? <Import size={19} /> : index === 1 ? <Users size={19} /> : <Sparkles size={19} />}</div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="security" class="security">
        <div class="security-pattern" aria-hidden="true"></div>
        <div class="container security-grid">
          <div class="security-copy">
            <p class="eyebrow">数据安全</p>
            <h2>权限不是页面上的开关，<br />而是数据本身的边界。</h2>
            <p>每个工作区拥有独立数据库边界。成员权限、实时查询与数据操作由数据库统一执行，结构管理只对管理员开放。</p>
            <div class="security-points">
              <span><ShieldCheck size={16} /> 工作区数据库天然隔离</span>
              <span><ShieldCheck size={16} /> 角色与数据权限统一约束</span>
              <span><ShieldCheck size={16} /> 所有操作保留真实身份归因</span>
            </div>
          </div>
          <div class="security-visual" aria-label="权限结构示意">
            <div class="security-core"><ShieldCheck size={28} /><strong>Workspace DB</strong><small>独立数据边界</small></div>
            <div class="role role-admin"><span>管</span><p><strong>管理员</strong><small>结构 + 数据</small></p><i></i></div>
            <div class="role role-member"><span>员</span><p><strong>团队成员</strong><small>按权限协作</small></p><i></i></div>
            <div class="role role-ai"><span><Sparkles size={13} /></span><p><strong>AI 助手</strong><small>沿用当前身份</small></p><i></i></div>
          </div>
        </div>
      </section>

      <section class="final-cta">
        <div class="container final-inner">
          <div class="final-seed seed-a" aria-hidden="true"></div>
          <div class="final-seed seed-b" aria-hidden="true"></div>
          <p>从一张熟悉的表格开始</p>
          <h2>让团队的数据，<br /><em>自己长出答案。</em></h2>
          <a class="button final-button" href={appUrl}>开始使用卯豆 <ArrowRight size={15} /></a>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-main">
        <div><Brand inverted /><p>AI 原生的数据工作空间</p></div>
        <nav aria-label="页脚导航">{navigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
        <a class="footer-login" href={appUrl}>进入工作空间 <ArrowRight size={14} /></a>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} 卯豆 Workspace</span><span>让数据自然生长</span></div>
    </footer>
  </div>
</BaseLayout>

<style>
  .page-shell {
    overflow: hidden;
  }

  .site-header {
    position: fixed;
    z-index: 50;
    top: 0;
    right: 0;
    left: 0;
    border-bottom: 1px solid rgba(218, 209, 190, .72);
    background: rgba(239, 235, 226, .86);
    backdrop-filter: blur(18px) saturate(135%);
  }

  .nav-inner {
    display: grid;
    height: 72px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .brand-link {
    justify-self: start;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 31px;
  }

  .desktop-nav a,
  .login-link {
    position: relative;
    color: var(--text-2);
    font-size: 12px;
    font-weight: 600;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -8px;
    left: 0;
    height: 1px;
    background: var(--primary);
    content: "";
    opacity: 0;
    transform: scaleX(.4);
    transition: opacity .2s ease, transform .2s ease;
  }

  .desktop-nav a:hover {
    color: var(--primary);
  }

  .desktop-nav a:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 19px;
  }

  .nav-cta {
    display: inline-flex;
    height: 38px;
    align-items: center;
    gap: 7px;
    padding: 0 14px;
    border-radius: 9px;
    background: var(--primary);
    color: white;
    font-size: 11px;
    font-weight: 700;
    transition: background-color .2s ease, transform .2s ease;
  }

  .nav-cta:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
  }

  .mobile-nav {
    display: none;
  }

  .hero {
    position: relative;
    padding: 151px 0 74px;
    background:
      radial-gradient(circle at 15% 30%, rgba(109, 184, 122, .13), transparent 26%),
      radial-gradient(circle at 86% 15%, rgba(204, 107, 58, .08), transparent 22%),
      var(--bg);
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    opacity: .25;
    background-image: repeating-radial-gradient(circle at 10% 20%, rgba(74, 61, 39, .15) 0, rgba(74, 61, 39, .15) .35px, transparent .5px, transparent 4px);
    background-size: 6px 6px;
    pointer-events: none;
  }

  .hero-orbit {
    position: absolute;
    border: 1px solid rgba(47, 122, 76, .1);
    border-radius: 50%;
    pointer-events: none;
  }

  .orbit-one { top: 140px; left: -190px; width: 420px; height: 420px; }
  .orbit-two { top: 85px; right: -135px; width: 310px; height: 310px; }

  .hero-content {
    position: relative;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    margin: 0;
    align-items: center;
    gap: 7px;
    padding: 7px 9px 7px 11px;
    border: 1px solid #d4ddcf;
    border-radius: 999px;
    background: rgba(251, 250, 245, .72);
    color: var(--primary);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
  }

  .hero-badge span {
    padding: 3px 5px;
    border-radius: 999px;
    background: var(--primary);
    color: white;
    font-size: 7px;
    letter-spacing: .06em;
  }

  .hero h1 {
    max-width: 950px;
    margin: 26px auto 0;
    font-family: var(--font-serif);
    font-size: clamp(48px, 7vw, 84px);
    font-weight: 600;
    letter-spacing: -.045em;
    line-height: 1.08;
  }

  .hero h1 em {
    color: var(--primary);
    font-style: italic;
    font-weight: 500;
  }

  .hero-lead {
    margin: 28px auto 0;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 11px;
    margin-top: 30px;
  }

  .hero-notes {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-top: 22px;
    color: var(--text-3);
    font-size: 10px;
  }

  .hero-notes span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .hero-notes svg { color: var(--primary); }

  .section-space {
    padding: 118px 0;
  }

  .premise {
    background: var(--surface);
  }

  .premise-grid {
    display: grid;
    grid-template-columns: 1.45fr .8fr;
    gap: 110px;
    align-items: end;
  }

  .premise h2,
  .section-heading h2,
  .template-intro h2,
  .workflow-head h2,
  .security-copy h2,
  .final-inner h2 {
    margin: 18px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(36px, 4.5vw, 57px);
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: 1.2;
  }

  .premise-copy {
    display: grid;
    gap: 18px;
    padding-bottom: 7px;
  }

  .premise-copy p {
    margin: 0;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.85;
  }

  .capabilities {
    background: var(--surface);
  }

  .section-heading {
    max-width: 690px;
    margin: 0 auto 54px;
    text-align: center;
  }

  .section-heading > p:last-child {
    margin: 17px 0 0;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.8;
  }

  .section-heading.compact {
    margin-bottom: 48px;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .capability-card {
    position: relative;
    min-height: 335px;
    overflow: hidden;
    padding: 31px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: #f7f4eb;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .capability-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(66, 55, 36, .08);
  }

  .capability-icon {
    display: grid;
    width: 42px;
    height: 42px;
    margin-bottom: 48px;
    place-items: center;
    border-radius: 12px;
    background: var(--primary-light);
    color: var(--primary);
  }

  .card-2 .capability-icon { background: var(--seed-soft); color: var(--seed-strong); }
  .card-3 .capability-icon { background: var(--purple-bg); color: var(--purple); }

  .capability-card > p {
    margin: 0 0 11px;
    color: var(--text-3);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .capability-card h3 {
    max-width: 280px;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 25px;
    font-weight: 600;
    line-height: 1.35;
  }

  .capability-card > span {
    display: block;
    margin-top: 15px;
    color: var(--text-2);
    font-size: 12px;
    line-height: 1.75;
  }

  .card-index {
    position: absolute;
    top: 21px;
    right: 24px;
    color: rgba(92, 84, 71, .2);
    font-family: var(--font-serif);
    font-size: 33px;
  }

  .showcase {
    background: var(--bg);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 17px;
  }

  .bento {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-dark);
    border-radius: 21px;
    background: var(--surface);
  }

  .views-card {
    min-height: 610px;
    grid-column: 1 / -1;
    padding: 48px 48px 0;
  }

  .bento-copy {
    max-width: 610px;
  }

  .feature-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--primary);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
  }

  .bento h3 {
    margin: 18px 0 0;
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -.025em;
    line-height: 1.3;
  }

  .bento-copy > p,
  .ai-showcase > p {
    max-width: 580px;
    margin: 14px 0 0;
    color: var(--text-2);
    font-size: 12px;
    line-height: 1.8;
  }

  .kanban-demo {
    position: absolute;
    right: 48px;
    bottom: -14px;
    left: 48px;
    min-width: 670px;
    min-height: 340px;

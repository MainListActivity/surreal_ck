    .mobile-nav nav { position: absolute; top: 49px; right: 0; display: grid; width: 250px; overflow: hidden; border: 1px solid var(--border-dark); border-radius: 13px; background: var(--surface); box-shadow: 0 18px 45px rgba(48,40,27,.14); }
    .mobile-nav nav a { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid var(--border); color: var(--text-2); font-size: 11px; }
    .mobile-nav nav a:last-child { border-bottom: 0; }
    .mobile-nav .mobile-login { background: var(--primary); color: white; font-weight: 700; }

    .hero-grid { grid-template-columns: 1fr; gap: 70px; }
    .hero-copy { max-width: 760px; }
    .hero-signal { width: min(520px, calc(100% - 38px)); margin-left: auto; }
    .hero-stage-shell { margin-top: 95px; }

    .premise-grid,
    .template-layout,
    .security-grid { grid-template-columns: 1fr; gap: 50px; }
    .capability-grid { grid-template-columns: 1fr; }
    .capability-card { min-height: 275px; }
    .capability-icon { margin-bottom: 32px; }
    .bento-grid { grid-template-columns: 1fr; }

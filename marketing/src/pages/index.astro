---
import {
  Activity,
  ArrowDown,
  ArrowRight,
  ChartColumn,
  Bot,
  Check,
  ChevronRight,
  CircleCheck,
  Database,
  FileSearch,
  GalleryVerticalEnd,
  Import,
  LayoutDashboard,
  Link2,
  Menu,
  Rows3,
  ShieldCheck,
  Sparkles,
  Table2,
  Users,
  WandSparkles,
  X,
} from "@lucide/astro";
import Brand from "../components/Brand.astro";
import LoginDialog from "../components/LoginDialog.astro";
import ProductStage from "../components/ProductStage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { capabilityCards, navigation, templateCards, workflowSteps } from "../data/product";

// 静态营销站与应用不同源：登录类按钮必须落到应用域名，同域 /auth/login 会被
// Pages fallback 吞成营销首页。可用 PUBLIC_APP_URL 覆盖（如预览环境）。
const appUrl = import.meta.env.PUBLIC_APP_URL || "https://l.maplayer.top/auth/login";
const iconByName = {
  database: Database,
  layout: GalleryVerticalEnd,
  sparkles: Sparkles,
} as const;
---

<BaseLayout>
  <div class="page-shell">
    <header class="site-header">
      <div class="container nav-inner">
        <a class="brand-link" href="#top" aria-label="卯豆首页"><Brand inverted /></a>
        <nav class="desktop-nav" aria-label="主导航">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="nav-actions">
          <a class="login-link" data-login-trigger href={appUrl}>登录</a>
          <a class="nav-cta" data-login-trigger href={appUrl}>开始使用 <ArrowRight size={14} /></a>
        </div>
        <details class="mobile-nav">
          <summary aria-label="打开导航"><Menu class="menu-open" size={21} /><X class="menu-close" size={21} /></summary>
          <nav aria-label="移动端导航">
            {navigation.map((item) => <a href={item.href}>{item.label}<ChevronRight size={14} /></a>)}
            <a class="mobile-login" data-login-trigger href={appUrl}>进入工作空间 <ArrowRight size={14} /></a>
          </nav>
        </details>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-grain" aria-hidden="true"></div>
        <div class="hero-grid-lines" aria-hidden="true"></div>
        <div class="hero-glow glow-one" aria-hidden="true"></div>
        <div class="hero-glow glow-two" aria-hidden="true"></div>
        <div class="container hero-content">
          <div class="hero-grid">
            <div class="hero-copy">
              <p class="hero-badge"><span class="pulse-dot"></span> AI 原生的数据工作空间 <em>2026</em></p>
              <h1 aria-label="工作不该困在表里，让数据自己向前走">
                <span class="hero-line"><span>工作不该</span></span>
                <span class="hero-line"><span>困在表里。</span></span>
                <span class="hero-line accent"><span>让数据自己向前走</span></span>
              </h1>
              <p class="hero-lead">
                一张表，是数据库、协作现场，也是 AI 的工作上下文。<br class="wide-only" />
                卯豆让信息不只被记录，而是持续形成判断与下一步。
              </p>
              <div class="hero-actions">
                <a class="button button-primary" data-login-trigger href={appUrl}>进入工作空间 <ArrowRight size={15} /></a>
                <a class="button button-secondary" href="#capabilities">探索产品能力 <ArrowDown size={14} /></a>
              </div>
              <div class="hero-notes" aria-label="产品特点">
                <span><Check size={13} /> 实时数据底座</span>
                <span><Check size={13} /> 多人协作</span>
                <span><Check size={13} /> 上下文 AI</span>
              </div>
            </div>

            <aside class="hero-signal" aria-label="实时工作状态示意">
              <div class="signal-head">
                <span><Activity size={14} /> LIVE WORKSPACE</span>
                <em>同步中</em>
              </div>
              <div class="signal-main">
                <p>本周业务推进率</p>
                <div><strong>84.6</strong><span>%</span><em>↑ 12.4%</em></div>
              </div>
              <div class="signal-chart" aria-hidden="true">
                {Array.from({ length: 18 }, (_, index) => (
                  <i style={`--signal-height: ${24 + ((index * 17) % 58)}%`}></i>
                ))}
              </div>
              <div class="signal-foot">
                <span><i></i> 126 条记录已分析</span>
                <span>刚刚更新</span>
              </div>
              <div class="signal-cursor cursor-one" aria-hidden="true"><b>林</b><span>正在编辑</span></div>
              <div class="signal-cursor cursor-two" aria-hidden="true"><b>AI</b><span>已生成视图</span></div>
            </aside>
          </div>
          <div class="hero-stage-shell">
            <div class="stage-caption" aria-hidden="true">
              <span>01 / PRODUCT VIEW</span>
              <span>SCROLL TO EXPLORE</span>
            </div>
            <ProductStage />
          </div>
        </div>
      </section>

      <section class="premise section-space" data-reveal>
        <div class="container premise-grid">
          <div>
            <p class="eyebrow">一个事实源，多种工作方式</p>
            <h2>不是给表格增加功能，<br />而是让工作重新围绕数据组织。</h2>
          </div>
          <div class="premise-copy">
            <p>团队真正需要的不是更多散落的工具，而是一份随时准确、人人都能理解、可以继续行动的数据。</p>
            <p>卯豆保留表格的直觉，把结构、关联、权限和智能藏在背后，让复杂工作仍然简单。</p>
          </div>
        </div>
      </section>

      <section id="capabilities" class="capabilities section-space" data-reveal>
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">产品能力</p>
            <h2>熟悉的开始，更深的可能</h2>
            <p>每一项能力都围绕同一个目标：让团队更快地从信息走向结论。</p>
          </div>
          <div class="capability-grid">
            {capabilityCards.map((item, index) => {
              const Icon = iconByName[item.icon];
              return (
                <article class:list={["capability-card", `card-${index + 1}`]} data-gsap-card>
                  <div class="capability-icon"><Icon size={20} stroke-width={1.8} /></div>
                  <p>{item.eyebrow}</p>
                  <h3>{item.title}</h3>
                  <span>{item.description}</span>
                  <div class="card-index">0{index + 1}</div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section class="showcase section-space" data-reveal>
        <div class="container">
          <div class="section-heading compact">
            <p class="eyebrow">从不同角度看见工作</p>
            <h2>一份数据，服务每一种角色</h2>
          </div>

          <div class="bento-grid">
            <article class="bento views-card" data-gsap-card>
              <div class="bento-copy">
                <span class="feature-label"><Rows3 size={15} /> 多视图协作</span>
                <h3>负责人看进度，管理者看全局，<br />数据仍然只有一份。</h3>
                <p>在表格、看板、画廊与表单之间自由切换，每个人都用适合自己的方式完成工作。</p>
              </div>
              <div class="kanban-demo" aria-label="看板视图示意">
                <div class="kanban-top"><strong>采购订单进度</strong><span><Table2 size={11} /> 表格</span><span class="active"><Rows3 size={11} /> 看板</span></div>
                <div class="kanban-columns">
                  <div><p><i class="dot sand"></i>待下单 <em>8</em></p><span><b>华远供应链</b><small>¥ 680,000 · 林澈</small></span><span><b>合信商贸</b><small>待确认交期</small></span></div>
                  <div><p><i class="dot orange"></i>备货中 <em>5</em></p><span><b>北辰实业</b><small>价格波动待确认</small></span><span><b>启航物流</b><small>今日更新</small></span></div>
                  <div><p><i class="dot green"></i>已到货 <em>24</em></p><span><b>知行科技</b><small>已排产</small></span><span class="ghost-card"><b>+ 新建记录</b></span></div>
                </div>
              </div>
            </article>

            <article class="bento ai-showcase" data-gsap-card>
              <div class="ai-orb"><WandSparkles size={22} /></div>
              <span class="feature-label light"><Sparkles size={15} /> 卯豆 AI</span>
              <h3>把问题说出来，<br />让答案回到工作里。</h3>
              <p>AI 会理解当前工作簿、筛选条件与记录关联，不只回答问题，还能生成视图、图表与下一步动作。</p>
              <div class="prompt-card">
                <p>“按负责人汇总延期的订单，并生成本周跟进计划。”</p>
                <div><span><Bot size={14} /> 正在分析 126 条记录</span><i></i><i></i><i></i></div>
              </div>
            </article>

            <article class="bento dashboard-card" data-gsap-card>
              <div class="bento-copy small-copy">
                <span class="feature-label"><ChartColumn size={15} /> 实时仪表盘</span>
                <h3>数字变化，结论同步更新</h3>
                <p>无需维护另一份报表，图表始终基于最新数据。</p>
              </div>
              <div class="chart-demo" aria-label="仪表盘图表示意">
                <header><span><small>采购总额</small><strong>¥12.84M</strong></span><em>较上周 +8.2%</em></header>
                <div class="chart-body">
                  <div class="y-axis"><span>12M</span><span>8M</span><span>4M</span><span>0</span></div>
                  <div class="bars"><i style="--bar:35%"></i><i style="--bar:52%"></i><i style="--bar:43%"></i><i style="--bar:68%"></i><i style="--bar:61%"></i><i class="active" style="--bar:84%"></i><i style="--bar:74%"></i></div>
                </div>
                <div class="chart-labels"><span>周一</span><span>周二</span><span>周三</span><span>周四</span><span>周五</span><span>周六</span><span>今日</span></div>
              </div>
            </article>

            <article class="bento research-card" data-gsap-card>
              <div class="bento-copy small-copy">
                <span class="feature-label"><FileSearch size={15} /> 资料与记录关联</span>
                <h3>结论有出处，材料有归属</h3>
                <p>把研究资料、证据与业务记录连接起来，随时追溯判断依据。</p>
              </div>
              <div class="link-demo">
                <div class="doc-card"><span>PDF</span><p><strong>采购合同.pdf</strong><small>12 页 · 已提取</small></p><CircleCheck size={15} /></div>
                <div class="connector"><i></i><Link2 size={14} /><i></i></div>
                <div class="record-card"><span>记录</span><p><small>供应商</small><strong>华远供应链</strong></p><p><small>订单金额</small><strong>¥ 680,000</strong></p></div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="templates" class="templates section-space" data-reveal>
        <div class="container template-layout">
          <div class="template-intro">
            <p class="eyebrow">行业模板</p>
            <h2>从行业经验开始，<br />不必从空白表格开始。</h2>
            <p>字段、视图和工作流程已经按实际场景组织好。选择模板，导入资料，然后按照团队习惯继续调整。</p>
            <a data-login-trigger href={appUrl}>浏览全部模板 <ArrowRight size={14} /></a>
          </div>
          <div class="template-list">
            {templateCards.map((template) => (
              <a class:list={["template-item", template.tone]} data-login-trigger href={appUrl}>
                <span class="template-number">{template.number}</span>
                <span class="template-icon"><LayoutDashboard size={18} /></span>
                <span class="template-name"><strong>{template.name}</strong><small>{template.meta}</small></span>
                <ChevronRight size={18} />
              </a>
            ))}
          </div>
        </div>
      </section>

      <section id="workflow" class="workflow section-space" data-reveal>
        <div class="container">
          <div class="workflow-head">
            <div><p class="eyebrow">工作方式</p><h2>三步，把信息变成团队能力</h2></div>
            <p>卯豆不要求团队改变熟悉的工作习惯，只把每一步连接得更自然。</p>
          </div>
          <div class="workflow-steps">
            {workflowSteps.map((step, index) => (
              <article data-gsap-card>
                <div class="step-top"><span>{step.number}</span>{index === 0 ? <Import size={19} /> : index === 1 ? <Users size={19} /> : <Sparkles size={19} />}</div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="security" class="security" data-reveal>
        <div class="security-pattern" aria-hidden="true"></div>
        <div class="container security-grid">
          <div class="security-copy">
            <p class="eyebrow">数据安全</p>
            <h2>权限不是页面上的开关，<br />而是数据本身的边界。</h2>
            <p>每个工作区拥有独立数据库边界。成员权限、实时查询与数据操作由数据库统一执行，结构管理只对管理员开放。</p>
            <div class="security-points">
              <span><ShieldCheck size={16} /> 工作区数据库天然隔离</span>
              <span><ShieldCheck size={16} /> 角色与数据权限统一约束</span>
              <span><ShieldCheck size={16} /> 所有操作保留真实身份归因</span>
            </div>
          </div>
          <div class="security-visual" aria-label="权限结构示意">
            <div class="security-core"><ShieldCheck size={28} /><strong>Workspace DB</strong><small>独立数据边界</small></div>
            <div class="role role-admin"><span>管</span><p><strong>管理员</strong><small>结构 + 数据</small></p><i></i></div>
            <div class="role role-member"><span>员</span><p><strong>团队成员</strong><small>按权限协作</small></p><i></i></div>
            <div class="role role-ai"><span><Sparkles size={13} /></span><p><strong>AI 助手</strong><small>沿用当前身份</small></p><i></i></div>
          </div>
        </div>
      </section>

      <section class="final-cta" data-reveal>
        <div class="container final-inner">
          <div class="final-seed seed-a" aria-hidden="true"></div>
          <div class="final-seed seed-b" aria-hidden="true"></div>
          <p>从一张熟悉的表格开始</p>
          <h2>让团队的数据，<br /><em>自己长出答案。</em></h2>
          <a class="button final-button" data-login-trigger href={appUrl}>开始使用卯豆 <ArrowRight size={15} /></a>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-main">
        <div><Brand inverted /><p>AI 原生的数据工作空间</p></div>
        <nav aria-label="页脚导航">{navigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
        <a class="footer-login" data-login-trigger href={appUrl}>进入工作空间 <ArrowRight size={14} /></a>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} 卯豆 Workspace</span><span>让数据自然生长</span></div>
    </footer>
  </div>
  <LoginDialog appUrl={appUrl} />
</BaseLayout>

<style>
  .page-shell {
    overflow: hidden;
  }

  .site-header {
    position: fixed;
    z-index: 50;
    top: 0;
    right: 0;
    left: 0;
    border-bottom: 1px solid rgba(255, 255, 255, .09);
    background: rgba(8, 27, 20, .72);
    backdrop-filter: blur(20px) saturate(125%);
    transition: background-color .35s ease, box-shadow .35s ease;
  }

  .site-header.is-scrolled {
    background: rgba(8, 27, 20, .94);
    box-shadow: 0 10px 40px rgba(3, 14, 10, .14);
  }

  .nav-inner {
    display: grid;
    height: 72px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .brand-link {
    justify-self: start;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 31px;
  }

  .desktop-nav a,
  .login-link {
    position: relative;
    color: rgba(233, 241, 231, .72);
    font-size: 12px;
    font-weight: 600;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -8px;
    left: 0;
    height: 1px;
    background: var(--primary);
    content: "";
    opacity: 0;
    transform: scaleX(.4);
    transition: opacity .2s ease, transform .2s ease;
  }

  .desktop-nav a:hover {
    color: #d9ff91;
  }

  .desktop-nav a:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 19px;
  }

  .nav-cta {
    display: inline-flex;
    height: 38px;
    align-items: center;
    gap: 7px;
    padding: 0 14px;
    border: 1px solid rgba(217, 255, 145, .24);
    border-radius: 999px;
    background: #d9ff91;
    color: #10261c;
    font-size: 11px;
    font-weight: 700;
    transition: background-color .2s ease, transform .2s ease;
  }

  .nav-cta:hover {
    background: #edffc8;
    transform: translateY(-1px);
  }

  .mobile-nav {
    display: none;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 156px 0 92px;
    background: #081b14;
    color: #f7f4e9;
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: .11;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.75'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  .hero-grid-lines {
    position: absolute;
    inset: 0;
    opacity: .22;
    background-image:
      linear-gradient(rgba(160, 203, 174, .12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(160, 203, 174, .12) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black, transparent 72%);
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(1px);
    pointer-events: none;
  }

  .glow-one {
    top: -210px;
    right: -140px;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(101, 201, 125, .17), transparent 67%);
  }

  .glow-two {
    top: 520px;
    left: -290px;
    width: 720px;
    height: 720px;
    background: radial-gradient(circle, rgba(217, 255, 145, .09), transparent 67%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, .55fr);
    gap: clamp(60px, 9vw, 132px);
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-badge {
    display: inline-flex;
    margin: 0;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    border: 1px solid rgba(201, 238, 208, .16);
    border-radius: 999px;
    background: rgba(224, 255, 228, .055);
    color: #b9d3bc;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .hero-badge .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d9ff91;
    box-shadow: 0 0 0 5px rgba(217, 255, 145, .09);
  }

  .hero-badge em {
    padding-left: 9px;
    border-left: 1px solid rgba(255,255,255,.13);
    color: #d9ff91;
    font-size: 8px;
    font-style: normal;
  }

  .hero h1 {
    max-width: 810px;
    margin: 31px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(58px, 7.2vw, 96px);
    font-weight: 500;
    letter-spacing: -.058em;
    line-height: .98;
  }

  .hero-line {
    display: block;
    overflow: hidden;
    padding: 0 .08em .08em 0;
  }

  .hero-line > span {
    display: block;
  }

  .hero-line.accent {
    color: #d9ff91;
    font-style: italic;
    font-size: .72em;
    letter-spacing: -.04em;
  }

  .hero-line.accent > span::after {
    display: inline-block;
    width: .18em;
    height: .18em;
    margin-left: .18em;
    border-radius: 50%;
    background: #ef7d4f;
    content: "";
    vertical-align: .14em;
  }

  .hero-lead {
    max-width: 680px;
    margin: 29px 0 0;
    color: #a9baae;
    font-size: 15px;
    line-height: 1.95;
  }

  .hero-actions {
    display: flex;
    gap: 11px;
    margin-top: 33px;
  }

  .hero .button-primary {
    background: #d9ff91;
    color: #10261c;
    box-shadow: 0 16px 36px rgba(168, 222, 117, .14);
  }

  .hero .button-primary:hover {
    background: #edffc8;
  }

  .hero .button-secondary {
    border-color: rgba(220, 239, 222, .18);
    background: rgba(255,255,255,.045);
    color: #dce8de;
  }

  .hero .button-secondary:hover {
    border-color: rgba(217,255,145,.45);
    background: rgba(255,255,255,.08);
  }

  .hero-notes {
    display: flex;

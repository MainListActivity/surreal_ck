</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const header = document.querySelector<HTMLElement>(".site-header");

  const syncHeader = (): void => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
  };

  syncHeader();
  window.addEventListener("scroll", syncHeader, { passive: true });

  if (!reducedMotion) {
    const intro = gsap.timeline({ defaults: { ease: "power3.out" } });
    const heroLines = gsap.utils.toArray<HTMLElement>(".hero-line > span");
    const signalBars = gsap.utils.toArray<HTMLElement>(".signal-chart i");

    intro
      .from(".site-header", { yPercent: -100, duration: .7 })
      .from(".hero-badge", { y: 18, autoAlpha: 0, duration: .55 }, "-=.25")
      .from(heroLines, { yPercent: 112, rotate: 2, duration: .9, stagger: .11 }, "-=.25")
      .from(".hero-lead", { y: 24, autoAlpha: 0, duration: .7 }, "-=.5")
      .from(".hero-actions, .hero-notes", { y: 18, autoAlpha: 0, duration: .6, stagger: .09 }, "-=.45")
      .from(".hero-signal", { x: 46, rotateY: -7, autoAlpha: 0, duration: .95 }, "-=.9")
      .from(signalBars, { scaleY: 0, duration: .7, stagger: .025, ease: "power2.out" }, "-=.55")
      .from(".signal-cursor", { scale: .75, autoAlpha: 0, duration: .45, stagger: .12 }, "-=.35")
      .from(".hero-stage-shell", { y: 90, rotateX: 8, autoAlpha: 0, duration: 1.05 }, "-=.4");

    gsap.to(".glow-one", {
      xPercent: -12,
      yPercent: 8,
      duration: 7,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
    });

    gsap.to(".pulse-dot", {
      scale: 1.55,
      opacity: .55,
      duration: 1.15,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
    });

    const stageWrap = document.querySelector<HTMLElement>(".hero-stage-shell .stage-wrap");
    if (stageWrap) {
      gsap.to(stageWrap, {
        y: -42,
        rotateX: 2.5,
        ease: "none",
        scrollTrigger: {
          trigger: stageWrap,
          start: "top 88%",
          end: "bottom 30%",
          scrub: 1,
        },
      });
    }

    gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((section) => {
      const heading = section.querySelector<HTMLElement>("h2");
      const copy = section.querySelector<HTMLElement>(".premise-copy, .section-heading > p:last-child, .workflow-head > p, .security-copy > p");
      const targets = [heading, copy].filter((target): target is HTMLElement => target !== null);
      if (targets.length === 0) return;

      gsap.from(targets, {
        y: 46,
        autoAlpha: 0,
        duration: .85,
        stagger: .1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: section,
          start: "top 76%",
          once: true,
        },
      });
    });

    gsap.utils.toArray<HTMLElement>("[data-gsap-card]").forEach((card, index) => {
      gsap.from(card, {
        y: 54,
        autoAlpha: 0,
        duration: .78,
        delay: (index % 3) * .07,
        ease: "power3.out",
        scrollTrigger: {
          trigger: card,
          start: "top 86%",
          once: true,
        },
      });
    });

    gsap.from(".chart-demo .bars i", {
      scaleY: 0,
      duration: .7,
      stagger: .06,
      transformOrigin: "bottom",
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".chart-demo",
        start: "top 82%",
        once: true,
      },
    });

    gsap.from(".security-visual .role", {
      scale: .8,
      autoAlpha: 0,
      duration: .65,
      stagger: .15,
      ease: "back.out(1.5)",
      scrollTrigger: {
        trigger: ".security-visual",
        start: "top 72%",
        once: true,
      },
    });

    if (window.matchMedia("(pointer: fine)").matches) {
      const signal = document.querySelector<HTMLElement>(".hero-signal");
      const hero = document.querySelector<HTMLElement>(".hero");
      hero?.addEventListener("pointermove", (event: PointerEvent) => {
        const x = event.clientX / window.innerWidth - .5;
        const y = event.clientY / window.innerHeight - .5;
        gsap.to(signal, { x: x * 12, y: y * 10, rotateY: x * 2, rotateX: y * -2, duration: .8, ease: "power2.out" });
        gsap.to(".cursor-one", { x: x * -18, y: y * -12, duration: 1, ease: "power2.out" });
        gsap.to(".cursor-two", { x: x * 15, y: y * 10, duration: 1.1, ease: "power2.out" });
      });
    }

    void document.fonts.ready.then(() => ScrollTrigger.refresh());
  }
</script>

---
import {
  ArrowRight,
  Bot,
  BookMarked,
  Check,
  ChevronRight,
  FileSpreadsheet,
  ListChecks,
  Menu,
  Scale,
  ShieldCheck,
  Sparkles,
  X,
} from "@lucide/astro";
import Brand from "../components/Brand.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  bankruptcyNavigation,
  capabilityCards,
  claimRows,
  factPoints,
  legalLinks,
  onboardingSteps,
  trialPoints,
} from "../data/bankruptcy";

const appUrl = import.meta.env.PUBLIC_APP_URL || "/auth/login";
const iconByName = {
  scale: Scale,
  fileSpreadsheet: FileSpreadsheet,
  listChecks: ListChecks,
  bookMarked: BookMarked,
} as const;
---

<BaseLayout
  title="卯豆｜破产管理人与律所的债权对账与法律研究工作台"
  description="面向破产管理人与律所：破产债权表按模板结构化建簿，申报记录逐项核对，AI 法律研究与引用保存留在同一工作台。第一阶段邀请制免费试用。"
>
  <div class="page-shell">
    <header class="site-header">
      <div class="container nav-inner">
        <a class="brand-link" href="/" aria-label="卯豆首页"><Brand /></a>
        <nav class="desktop-nav" aria-label="主导航">
          {bankruptcyNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="nav-actions">
          <a class="login-link" href={appUrl}>登录</a>
          <a class="nav-cta" href="#trial">了解试用 <ArrowRight size={14} /></a>
        </div>
        <details class="mobile-nav">
          <summary aria-label="打开导航"><Menu class="menu-open" size={21} /><X class="menu-close" size={21} /></summary>
          <nav aria-label="移动端导航">
            {bankruptcyNavigation.map((item) => <a href={item.href}>{item.label}<ChevronRight size={14} /></a>)}
            <a class="mobile-login" href={appUrl}>进入工作空间 <ArrowRight size={14} /></a>
          </nav>
        </details>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-grain" aria-hidden="true"></div>
        <div class="container hero-content">
          <p class="hero-badge"><Scale size={13} /> 第一阶段 · 邀请制免费试用</p>
          <h1>债权核对到法律研究，<br /><em>在同一个工作台上完成。</em></h1>
          <p class="hero-lead">
            面向破产管理人与律所：破产债权表按模板结构化建簿，申报记录逐项核对，<br class="wide-only" />
            AI 法律研究的结论与引用留在同一处，随时回溯出处。
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#trial">联系邀请人开通试用 <ArrowRight size={15} /></a>
            <a class="button button-secondary" href="#capabilities">看看能做什么</a>
          </div>
          <div class="hero-notes" aria-label="产品特点">
            <span><Check size={13} /> 模板一键建簿，含或不含样例数据</span>
            <span><Check size={13} /> Excel 申报记录批量导入</span>
            <span><Check size={13} /> AI 提案经人工确认才写回</span>
          </div>

          <div class="stage-wrap" aria-label="债权申报工作表示意（数据为演示样例）">
            <div class="stage-shadow" aria-hidden="true"></div>
            <div class="stage">
              <div class="window-bar">
                <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
                <span>破产债权工作空间 · 示意数据</span>
              </div>
              <div class="sheet">
                <div class="sheet-row sheet-head"><span>#</span><span>债权人</span><span>债权性质</span><span>申报金额</span><span>审定金额</span><span>审查状态</span></div>
                {claimRows.map((row, index) => (
                  <div class="sheet-row">
                    <span>{index + 1}</span>
                    <span class="company">{row.name}</span>
                    <span>{row.nature}</span>
                    <span>{row.declared}</span>
                    <span>{row.confirmed}</span>
                    <span><em class:list={["status", row.tone]}>{row.status}</em></span>
                  </div>
                ))}
              </div>
              <div class="ai-card">
                <div class="ai-head"><span><Sparkles size={13} />行分析</span><em>提案待确认</em></div>
                <p>该笔申报缺少利息计算依据，且申报金额与合同金额不一致。</p>
                <div class="ai-answer">
                  <span><Bot size={14} /></span>
                  <div><strong>已生成字段补全提案</strong><small>附依据说明，经确认后才写回</small></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="premise section-space">
        <div class="container premise-grid">
          <div>
            <p class="eyebrow">为什么需要它</p>
            <h2>通用表格装得下数据，<br />装不下债权审查过程。</h2>
          </div>
          <div class="premise-copy">
            <p>破产案件里，债权申报来自几百上千条 Excel 与材料，审查口径需要全团队一致，每个审定数字都要能说明依据。</p>
            <p>卯豆把建簿、导入、逐项核对与法律研究组织在同一条工作路径上，让审查过程本身就是可追溯的数据。</p>
          </div>
        </div>
      </section>

      <section id="capabilities" class="capabilities section-space">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">产品能力</p>
            <h2>围绕债权核对的真实工作</h2>
            <p>从建簿到研究，每一步都在同一个工作区内完成。</p>
          </div>
          <div class="capability-grid">
            {capabilityCards.map((item, index) => {
              const Icon = iconByName[item.icon];
              return (
                <article class:list={["capability-card", `card-${index + 1}`]}>
                  <div class="capability-icon"><Icon size={20} stroke-width={1.8} /></div>
                  <p>{item.eyebrow}</p>
                  <h3>{item.title}</h3>
                  <span>{item.description}</span>
                  <div class="card-index">0{index + 1}</div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section id="workflow" class="workflow section-space">
        <div class="container">
          <div class="workflow-head">
            <div><p class="eyebrow">上手路径</p><h2>四步，从开通到第一份研究记录</h2></div>
            <p>不改变团队熟悉的工作习惯，只把每一步接起来。</p>
          </div>
          <div class="workflow-steps">
            {onboardingSteps.map((step) => (
              <article>
                <div class="step-top"><span>{step.number}</span></div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="trial" class="trial section-space">
        <div class="container trial-inner">
          <div class="section-heading">
            <p class="eyebrow">试用说明</p>
            <h2>第一阶段：免费 · 邀请制</h2>
          </div>
          <div class="trial-grid">
            {trialPoints.map((point) => (
              <article>
                <h3>{point.title}</h3>
                <p>{point.description}</p>
              </article>
            ))}
          </div>
          <p class="trial-note">AI 的分析与建议仅供审查参考，不构成法律意见；是否采纳由审查人判断并负责。</p>
        </div>
      </section>

      <section class="facts">
        <div class="container facts-grid">
          <div class="facts-copy">
            <p class="eyebrow">数据与权限</p>
            <h2>边界由数据本身执行。</h2>
          </div>
          <div class="facts-points">
            {factPoints.map((point) => <span><ShieldCheck size={16} /> {point}</span>)}
          </div>
        </div>
      </section>

      <section class="final-cta">
        <div class="container final-inner">
          <p>第一阶段 · 邀请制免费试用</p>
          <h2>把债权核对，<br /><em>放回一条完整的工作路径上。</em></h2>
          <a class="button final-button" href="#trial">联系邀请人开通 <ArrowRight size={15} /></a>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-main">
        <div><Brand inverted /><p>AI 原生的数据工作空间</p></div>
        <nav aria-label="页脚导航">
          <a href="/">产品首页</a>
          {bankruptcyNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="footer-login" href={appUrl}>进入工作空间 <ArrowRight size={14} /></a>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} 卯豆 Workspace</span>
        <span class="legal-links">
          {legalLinks.map((link) =>
            link.href ? <a href={link.href}>{link.label}</a> : <span class="legal-pending">{link.label}（即将上线）</span>
          )}
        </span>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .page-shell {
    overflow: hidden;
  }

  .site-header {
    position: fixed;
    z-index: 50;
    top: 0;
    right: 0;
    left: 0;
    border-bottom: 1px solid rgba(218, 209, 190, .72);
    background: rgba(239, 235, 226, .86);
    backdrop-filter: blur(18px) saturate(135%);
  }

  .nav-inner {
    display: grid;
    height: 72px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .brand-link {
    justify-self: start;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 31px;
  }

  .desktop-nav a,
  .login-link {
    position: relative;
    color: var(--text-2);
    font-size: 12px;
    font-weight: 600;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -8px;
    left: 0;
    height: 1px;
    background: var(--primary);
    content: "";
    opacity: 0;
    transform: scaleX(.4);
    transition: opacity .2s ease, transform .2s ease;
  }

  .desktop-nav a:hover {
    color: var(--primary);
  }

  .desktop-nav a:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 19px;
  }

  .nav-cta {
    display: inline-flex;
    height: 38px;
    align-items: center;
    gap: 7px;
    padding: 0 14px;
    border-radius: 9px;
    background: var(--primary);
    color: white;
    font-size: 11px;
    font-weight: 700;
    transition: background-color .2s ease, transform .2s ease;
  }

  .nav-cta:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
  }

  .mobile-nav {
    display: none;
  }

  .hero {
    position: relative;
    padding: 151px 0 74px;
    background:
      radial-gradient(circle at 15% 30%, rgba(109, 184, 122, .13), transparent 26%),
      radial-gradient(circle at 86% 15%, rgba(204, 107, 58, .08), transparent 22%),
      var(--bg);
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    opacity: .25;
    background-image: repeating-radial-gradient(circle at 10% 20%, rgba(74, 61, 39, .15) 0, rgba(74, 61, 39, .15) .35px, transparent .5px, transparent 4px);
    background-size: 6px 6px;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    margin: 0;
    align-items: center;
    gap: 8px;
    padding: 8px 15px;
    border: 1px solid var(--border-dark);
    border-radius: 999px;
    background: rgba(251, 250, 245, .8);
    color: var(--primary);
    font-size: 11px;
    font-weight: 700;
  }

  h1 {
    margin: 26px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(38px, 5.4vw, 62px);
    font-weight: 600;
    letter-spacing: .01em;
    line-height: 1.18;
  }

  h1 em {
    color: var(--primary);
    font-style: normal;
  }

  .hero-lead {
    margin: 24px auto 0;
    max-width: 660px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    margin-top: 34px;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-notes {
    display: flex;
    margin-top: 26px;
    align-items: center;
    justify-content: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .hero-notes span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-2);
    font-size: 12px;
    font-weight: 600;
  }

  .hero-notes svg {
    color: var(--primary);
  }

  .stage-wrap {
    position: relative;
    width: min(980px, 100%);
    margin: 58px auto 0;
  }

  .stage-shadow {
    position: absolute;
    right: 10%;
    bottom: -12px;
    left: 10%;
    height: 60%;
    border-radius: 50%;
    background: rgba(67, 73, 53, .2);
    filter: blur(42px);
  }

  .stage {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .82);
    border-radius: 24px;
    background: var(--surface);
    box-shadow: 0 30px 75px rgba(67, 57, 39, .18), 0 4px 14px rgba(67, 57, 39, .08);
    text-align: left;
  }

  .window-bar {
    display: grid;
    height: 42px;
    grid-template-columns: auto 1fr;
    align-items: center;
    border-bottom: 1px solid var(--border);
    background: rgba(251, 250, 245, .92);
    color: var(--text-3);
    font-size: 10px;
  }

  .window-dots {
    display: flex;
    gap: 5px;
    padding: 0 15px;
  }

  .window-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d9d2c5;
  }

  .window-dots i:nth-child(2) { background: #e1b693; }
  .window-dots i:nth-child(3) { background: #9ac2a1; }

  .sheet {
    padding: 18px 22px 26px;
  }

  .sheet-row {
    display: grid;
    padding: 12px 6px;
    grid-template-columns: 34px 1.6fr 1fr 1fr 1fr 1fr;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--border);
    color: var(--text-2);
    font-size: 12px;
  }

  .sheet-head {
    color: var(--text-3);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
  }

  .sheet-row .company {
    color: var(--text-1);
    font-weight: 700;
  }

  .status {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 10px;
    font-style: normal;
    font-weight: 700;
  }

  .status.green { background: var(--success-bg); color: var(--success); }
  .status.orange { background: var(--warning-bg); color: var(--warning); }
  .status.sand { background: #f3ede1; color: #8a6f4d; }
  .status.purple { background: var(--purple-bg); color: var(--purple); }

  .ai-card {
    margin: 0 22px 22px;
    padding: 15px 17px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface-2);
  }

  .ai-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--primary);
    font-size: 11px;
    font-weight: 700;
  }

  .ai-head span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ai-head em {
    color: var(--text-3);
    font-style: normal;
    font-weight: 600;
  }

  .ai-card > p {
    margin: 10px 0 0;
    color: var(--text-1);
    font-size: 12px;
    line-height: 1.7;
  }

  .ai-answer {
    display: flex;
    margin-top: 12px;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--primary-light);
  }

  .ai-answer svg {
    color: var(--primary);
  }

  .ai-answer strong {
    display: block;
    color: var(--primary);
    font-size: 11px;
  }

  .ai-answer small {
    color: var(--text-2);
    font-size: 10px;
  }

  .section-space {
    padding: 96px 0;
  }

  .premise-grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 60px;
    align-items: start;
  }

  h2 {
    margin: 14px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(27px, 3.4vw, 40px);
    font-weight: 600;
    letter-spacing: .01em;
    line-height: 1.3;
  }

  .premise-copy {
    display: grid;
    gap: 16px;
    padding-top: 34px;
  }

  .premise-copy p {
    margin: 0;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.9;
  }

  .section-heading {
    max-width: 560px;
    margin-bottom: 44px;
  }

  .section-heading > p:last-child {
    margin: 14px 0 0;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.8;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .capability-card {
    position: relative;
    overflow: hidden;
    padding: 30px 28px 34px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
  }

  .capability-icon {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 12px;
    background: var(--primary-light);
    color: var(--primary);
  }

  .card-2 .capability-icon { background: var(--seed-soft); color: var(--seed-strong); }
  .card-3 .capability-icon { background: var(--purple-bg); color: var(--purple); }
  .card-4 .capability-icon { background: #f3ede1; color: #8a6f4d; }

  .capability-card > p {
    margin: 20px 0 0;
    color: var(--primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .1em;
  }

  .capability-card h3 {
    margin: 8px 0 0;
    font-size: 19px;
    font-weight: 700;
  }

  .capability-card > span {
    display: block;
    margin-top: 10px;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.85;
  }

  .card-index {
    position: absolute;
    right: 22px;
    bottom: 14px;
    color: var(--soft);
    font-family: var(--font-serif);
    font-size: 44px;
    font-weight: 600;
  }

  .workflow-head {
    display: grid;
    margin-bottom: 40px;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 40px;
  }

  .workflow-head > p {
    max-width: 300px;
    margin: 0;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.8;
    text-align: right;
  }

  .workflow-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .workflow-steps article {
    padding: 26px 24px 30px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
  }

  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--primary);
  }

  .step-top span {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 600;
  }

  .workflow-steps h3 {
    margin: 18px 0 0;
    font-size: 16px;
    font-weight: 700;
  }

  .workflow-steps p {
    margin: 10px 0 0;
    color: var(--text-2);
    font-size: 12px;
    line-height: 1.85;
  }

  .trial-inner {
    padding: 54px 56px;
    border: 1px solid var(--border-dark);
    border-radius: 26px;
    background: var(--surface);
  }

  .trial-inner .section-heading {
    margin-bottom: 34px;
  }

  .trial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .trial-grid article {
    padding: 24px 22px 26px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface-2);
  }

  .trial-grid h3 {
    margin: 0;
    color: var(--primary);
    font-size: 15px;
    font-weight: 700;
  }

  .trial-grid p {
    margin: 10px 0 0;
    color: var(--text-2);
    font-size: 12px;
    line-height: 1.85;
  }

  .trial-note {
    margin: 30px 0 0;
    padding-top: 22px;
    border-top: 1px dashed var(--border-dark);
    color: var(--text-3);
    font-size: 12px;
    line-height: 1.8;
  }

  .facts {
    padding: 80px 0;
    background: #2a3328;
    color: #efebe0;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: center;
  }

  .facts .eyebrow {
    color: var(--brand-mid);
  }

  .facts h2 {
    color: #f8f4e9;
  }

  .facts-points {
    display: grid;
    gap: 14px;
  }

  .facts-points span {
    display: flex;
    padding: 15px 18px;
    align-items: center;

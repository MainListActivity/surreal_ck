---
import JijiLogo from "./JijiLogo.astro";

interface Props {
  inverted?: boolean;
}

const { inverted = false } = Astro.props;
---

<span class:list={["brand", { inverted }]} aria-label="吉吉">
  <span class="brand-mark" aria-hidden="true"><JijiLogo variant="wall" size={38} /></span>
  <span class="brand-words">
    <strong>吉吉</strong>
    <small>Workspace</small>
  </span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-1);
  }

  .brand.inverted {
    color: #f8f4e9;
  }

  .brand-mark {
    display: block;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
  }

  .inverted .brand-mark {
    border-radius: 11px;
    box-shadow: 0 0 0 1px rgba(245, 197, 66, .16);
  }

  .brand-words {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-words strong {
    font-family: var(--font-sans);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: .08em;
  }

  .brand-words small {
    margin-top: 4px;
    color: var(--text-3);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  .inverted .brand-words small {
    color: #a9b8aa;
  }
</style>

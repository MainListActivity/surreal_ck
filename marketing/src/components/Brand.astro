---
interface Props {
  inverted?: boolean;
}

const { inverted = false } = Astro.props;
---

<span class:list={["brand", { inverted }]} aria-label="卯豆">
  <span class="brand-mark" aria-hidden="true">
    <span class="soil"></span>
    <span class="stem stem-left"><i></i></span>
    <span class="stem stem-right"><i></i></span>
    <span class="seed seed-left"></span>
    <span class="seed seed-right"></span>
  </span>
  <span class="brand-words">
    <strong>卯豆</strong>
    <small>Workspace</small>
  </span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-1);
  }

  .brand.inverted {
    color: #f8f4e9;
  }

  .brand-mark {
    position: relative;
    display: block;
    width: 38px;
    height: 38px;
    overflow: hidden;
    border-radius: 11px;
    background: var(--primary-light);
  }

  .soil {
    position: absolute;
    right: 8px;
    bottom: 8px;
    left: 8px;
    height: 6px;
    border-top: 1.5px solid #a88c68;
    border-radius: 50%;
  }

  .stem {
    position: absolute;
    bottom: 9px;
    width: 2px;
    height: 18px;
    border-radius: 2px;
    background: var(--primary);
  }

  .stem-left { left: 14px; }
  .stem-right { right: 13px; height: 15px; }

  .stem::before,
  .stem::after,
  .stem i {
    position: absolute;
    display: block;
    width: 8px;
    height: 5px;
    content: "";
    background: var(--brand-mid);
  }

  .stem::before {
    top: 3px;
    right: 1px;
    border-radius: 8px 1px 8px 1px;
    transform: rotate(18deg);
  }

  .stem::after {
    top: 8px;
    left: 1px;
    border-radius: 1px 8px 1px 8px;
    transform: rotate(-18deg);
  }

  .stem i {
    top: -2px;
    left: 0;
    width: 6px;
    height: 5px;
    border-radius: 1px 8px 1px 8px;
    background: #8dd49a;
    transform: rotate(-35deg);
  }

  .seed {
    position: absolute;
    bottom: 6px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--seed);
  }

  .seed-left { left: 12.5px; }
  .seed-right { right: 11.5px; }

  .brand-words {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-words strong {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: .04em;
  }

  .brand-words small {
    margin-top: 4px;
    color: var(--text-3);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  .inverted .brand-words small {
    color: #a9b8aa;
  }
</style>
